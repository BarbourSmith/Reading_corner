              ],
              "interpreterVersion": 1,
              "code": "/** Alcove back (window) wall. Room face at faceY, window opening cut through. mm, scan coordinates. */\nfunction run(\n  xLeft: number = -1308,\n  xRight: number = 1207,\n  faceY: number = 155,\n  wallThick: number = 165,\n  ceilingZ: number = 2575,\n  winL: number = -980,\n  winR: number = 880,\n  winSill: number = 450,\n  winHead: number = 1990,\n): Assembly {\n  const box = (a: number[], b: number[]) => replicad.makeBox(a, b);\n  let wall = box([xLeft, faceY, 0], [xRight, faceY + wallThick, ceilingZ]);\n  wall = wall.cut(box([winL, faceY - 1, winSill], [winR, faceY + wallThick + 1, winHead]));\n  return new Assembly({ geometry: wall, color: \"#efede8\" });\n}\n",
              "compiledCode": "\"use strict\";\n/** Alcove back (window) wall. Room face at faceY, window opening cut through. mm, scan coordinates. */\nfunction run(xLeft = -1308, xRight = 1207, faceY = 155, wallThick = 165, ceilingZ = 2575, winL = -980, winR = 880, winSill = 450, winHead = 1990) {\n    const box = (a, b) => replicad.makeBox(a, b);\n    let wall = box([xLeft, faceY, 0], [xRight, faceY + wallThick, ceilingZ]);\n    wall = wall.cut(box([winL, faceY - 1, winSill], [winR, faceY + wallThick + 1, winHead]));\n    return new Assembly({ geometry: wall, color: \"#efede8\" });\n}\n"
            }
