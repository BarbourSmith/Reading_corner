                  "ioValue": 45
                }
              ],
              "interpreterVersion": 1,
              "code": "/** Alcove Window frame: white sash frame filling the rough opening, set at the outside face of the wall (outerY). mm, scan coordinates. */\nfunction run(\n  winL: number = -980,\n  winR: number = 880,\n  winSill: number = 450,\n  winHead: number = 1990,\n  outerY: number = 320,\n  frameDepth: number = 60,\n  frameWidth: number = 45,\n): Assembly {\n  const box = (a: number[], b: number[]) => replicad.makeBox(a, b);\n  const y0 = outerY - frameDepth;\n  const outer = box([winL, y0, winSill], [winR, outerY, winHead]);\n  const inner = box([winL + frameWidth, y0 - 1, winSill + frameWidth], [winR - frameWidth, outerY + 1, winHead - frameWidth]);\n  return new Assembly({ geometry: outer.cut(inner), color: \"#f7f7f5\" });\n}\n",
              "compiledCode": "\"use strict\";\n/** Alcove Window frame: white sash frame filling the rough opening, set at the outside face of the wall (outerY). mm, scan coordinates. */\nfunction run(winL = -980, winR = 880, winSill = 450, winHead = 1990, outerY = 320, frameDepth = 60, frameWidth = 45) {\n    const box = (a, b) => replicad.makeBox(a, b);\n    const y0 = outerY - frameDepth;\n    const outer = box([winL, y0, winSill], [winR, outerY, winHead]);\n    const inner = box([winL + frameWidth, y0 - 1, winSill + frameWidth], [winR - frameWidth, outerY + 1, winHead - frameWidth]);\n    return new Assembly({ geometry: outer.cut(inner), color: \"#f7f7f5\" });\n}\n"
            },
            {
              "atomType": "Code",
              "x": 0.3,
              "y": 0.3,
              "uniqueID": "id-2317",
              "ioValues": [
