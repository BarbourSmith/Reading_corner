          "interpreterVersion": 1,
          "code": "/** Alcove Window black vertical grille bars, evenly spaced on the room side of the glass. mm, scan coordinates. */\nfunction run(\n  winL: number = -980,\n  winR: number = 880,\n  winSill: number = 450,\n  winHead: number = 1990,\n  outerY: number = 320,\n  frameDepth: number = 60,\n  frameWidth: number = 45,\n  glassThick: number = 6,\n  barCount: number = 3,\n  barWidth: number = 30,\n  barDepth: number = 10,\n): Assembly {\n  const midY = outerY - frameDepth / 2;\n  const yGlass = midY - glassThick / 2; // room-side face of the glass\n  const x0 = winL + frameWidth;\n  const span = winR - frameWidth - x0;\n  let bars = null;\n  for (let i = 1; i <= barCount; i++) {\n    const cx = x0 + (span * i) / (barCount + 1);\n    const bar = replicad.makeBox(\n      [cx - barWidth / 2, yGlass - barDepth, winSill + frameWidth],\n      [cx + barWidth / 2, yGlass, winHead - frameWidth],\n    );\n    bars = bars ? bars.fuse(bar) : bar;\n  }\n  return new Assembly({ geometry: bars, color: \"#262626\", tags: [\"window\"] });\n}\n",
          "compiledCode": "\"use strict\";\n/** Alcove Window black vertical grille bars, evenly spaced on the room side of the glass. mm, scan coordinates. */\nfunction run(winL = -980, winR = 880, winSill = 450, winHead = 1990, outerY = 320, frameDepth = 60, frameWidth = 45, glassThick = 6, barCount = 3, barWidth = 30, barDepth = 10) {\n    const midY = outerY - frameDepth / 2;\n    const yGlass = midY - glassThick / 2; // room-side face of the glass\n    const x0 = winL + frameWidth;\n    const span = winR - frameWidth - x0;\n    let bars = null;\n    for (let i = 1; i <= barCount; i++) {\n        const cx = x0 + (span * i) / (barCount + 1);\n        const bar = replicad.makeBox([cx - barWidth / 2, yGlass - barDepth, winSill + frameWidth], [cx + barWidth / 2, yGlass, winHead - frameWidth]);\n        bars = bars ? bars.fuse(bar) : bar;\n    }\n    return new Assembly({ geometry: bars, color: \"#262626\", tags: [\"window\"] });\n}\n"
        },
