          ],
          "interpreterVersion": 1,
          "code": "/** Wood-paneled wall to the right of the right window, running toward the room. Face at faceX. mm, scan coordinates. */\nfunction run(\n  faceX: number = 2285,\n  wallThick: number = 165,\n  yNear: number = -1500,\n  yFar: number = -455,\n  ceilingZ: number = 2575,\n): Assembly {\n  const wall = replicad.makeBox([faceX, yNear, 0], [faceX + wallThick, yFar, ceilingZ]);\n  return new Assembly({ geometry: wall, color: \"#b8895a\", tags: [\"wall\"] });\n}\n",
          "compiledCode": "\"use strict\";\n/** Wood-paneled wall to the right of the right window, running toward the room. Face at faceX. mm, scan coordinates. */\nfunction run(faceX = 2285, wallThick = 165, yNear = -1500, yFar = -455, ceilingZ = 2575) {\n    const wall = replicad.makeBox([faceX, yNear, 0], [faceX + wallThick, yFar, ceilingZ]);\n    return new Assembly({ geometry: wall, color: \"#b8895a\", tags: [\"wall\"] });\n}\n"
        }
