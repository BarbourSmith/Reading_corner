              ],
              "interpreterVersion": 1,
              "code": "/** Window seat top board; sits on the base and overhangs its front. Top at seatHeight (scan ~290). mm, scan coordinates. */\nfunction run(\n  xLeft: number = -1143,\n  xRight: number = 1042,\n  frontY: number = -560,\n  backY: number = 155,\n  seatHeight: number = 290,\n  boardThick: number = 25,\n): Assembly {\n  const top = replicad.makeBox([xLeft, frontY, seatHeight - boardThick], [xRight, backY, seatHeight]);\n  return new Assembly({ geometry: top, color: \"#fbfbfa\" });\n}\n",
              "compiledCode": "\"use strict\";\n/** Window seat top board; sits on the base and overhangs its front. Top at seatHeight (scan ~290). mm, scan coordinates. */\nfunction run(xLeft = -1143, xRight = 1042, frontY = -560, backY = 155, seatHeight = 290, boardThick = 25) {\n    const top = replicad.makeBox([xLeft, frontY, seatHeight - boardThick], [xRight, backY, seatHeight]);\n    return new Assembly({ geometry: top, color: \"#fbfbfa\" });\n}\n"
            }
          ],
