          ],
          "interpreterVersion": 1,
          "code": "/** Floor slab; top face at z = 0 (scan floor level). Dimensions in mm, scan coordinates. */\nfunction run(\n  xMin: number = -2850,\n  xMax: number = 2285,\n  yMin: number = -2400,\n  yMax: number = 320,\n  thickness: number = 20,\n): Assembly {\n  const slab = replicad.makeBox([xMin, yMin, -thickness], [xMax, yMax, 0]);\n  return new Assembly({ geometry: slab, color: \"#7a4a2e\", tags: [\"floor\"] });\n}\n",
          "compiledCode": "\"use strict\";\n/** Floor slab; top face at z = 0 (scan floor level). Dimensions in mm, scan coordinates. */\nfunction run(xMin = -2850, xMax = 2285, yMin = -2400, yMax = 320, thickness = 20) {\n    const slab = replicad.makeBox([xMin, yMin, -thickness], [xMax, yMax, 0]);\n    return new Assembly({ geometry: slab, color: \"#7a4a2e\", tags: [\"floor\"] });\n}\n"
        }
      ],
