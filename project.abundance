              "interpreterVersion": 1,
              "code": "/** Built-in window seat base, wall to wall in the alcove. Front face at frontY. mm, scan coordinates. */\nfunction run(\n  xLeft: number = -1143,\n  xRight: number = 1042,\n  frontY: number = -545,\n  backY: number = 155,\n  baseHeight: number = 265,\n): Assembly {\n  const base = replicad.makeBox([xLeft, frontY, 0], [xRight, backY, baseHeight]);\n  return new Assembly({ geometry: base, color: \"#f4f4f2\" });\n}\n",
              "compiledCode": "\"use strict\";\n/** Built-in window seat base, wall to wall in the alcove. Front face at frontY. mm, scan coordinates. */\nfunction run(xLeft = -1143, xRight = 1042, frontY = -545, backY = 155, baseHeight = 265) {\n    const base = replicad.makeBox([xLeft, frontY, 0], [xRight, backY, baseHeight]);\n    return new Assembly({ geometry: base, color: \"#f4f4f2\" });\n}\n"
            }
