              "code": "/** Right Window frame: white sash frame filling the rough opening, set at the outside face of the wall (outerY). mm, scan coordinates. */\nfunction run(\n  winL: number = 1265,\n  winR: number = 2141,\n  winSill: number = 510,\n  winHead: number = 2150,\n  outerY: number = -455,\n  frameDepth: number = 60,\n  frameWidth: number = 45,\n): Assembly {\n  const box = (a: number[], b: number[]) => replicad.makeBox(a, b);\n  const y0 = outerY - frameDepth;\n  const outer = box([winL, y0, winSill], [winR, outerY, winHead]);\n  const inner = box([winL + frameWidth, y0 - 1, winSill + frameWidth], [winR - frameWidth, outerY + 1, winHead - frameWidth]);\n  return new Assembly({ geometry: outer.cut(inner), color: \"#f7f7f5\" });\n}\n",
              "compiledCode": "\"use strict\";\n/** Right Window frame: white sash frame filling the rough opening, set at the outside face of the wall (outerY). mm, scan coordinates. */\nfunction run(winL = 1265, winR = 2141, winSill = 510, winHead = 2150, outerY = -455, frameDepth = 60, frameWidth = 45) {\n    const box = (a, b) => replicad.makeBox(a, b);\n    const y0 = outerY - frameDepth;\n    const outer = box([winL, y0, winSill], [winR, outerY, winHead]);\n    const inner = box([winL + frameWidth, y0 - 1, winSill + frameWidth], [winR - frameWidth, outerY + 1, winHead - frameWidth]);\n    return new Assembly({ geometry: outer.cut(inner), color: \"#f7f7f5\" });\n}\n"
