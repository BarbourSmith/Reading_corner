          "interpreterVersion": 1,
          "code": "/** Alcove Window Casing: flat painted trim around the opening, proud of the wall face at faceY (picture frame on all four sides). mm, scan coordinates. */\nfunction run(\n  openL: number = -980,\n  openR: number = 880,\n  openBottom: number = 450,\n  openTop: number = 1990,\n  faceY: number = 155,\n  trimWidth: number = 60,\n  trimThick: number = 20,\n  legsToFloor: boolean = false,\n): Assembly {\n  const box = (a: number[], b: number[]) => replicad.makeBox(a, b);\n  const bottom = legsToFloor ? 0 : openBottom - trimWidth;\n  const outer = box([openL - trimWidth, faceY - trimThick, bottom], [openR + trimWidth, faceY, openTop + trimWidth]);\n  const inner = box([openL, faceY - trimThick - 1, legsToFloor ? -1 : openBottom], [openR, faceY + 1, openTop]);\n  return new Assembly({ geometry: outer.cut(inner), color: \"#ffffff\", tags: [\"trim\"] });\n}\n",
          "compiledCode": "\"use strict\";\n/** Alcove Window Casing: flat painted trim around the opening, proud of the wall face at faceY (picture frame on all four sides). mm, scan coordinates. */\nfunction run(openL = -980, openR = 880, openBottom = 450, openTop = 1990, faceY = 155, trimWidth = 60, trimThick = 20, legsToFloor = false) {\n    const box = (a, b) => replicad.makeBox(a, b);\n    const bottom = legsToFloor ? 0 : openBottom - trimWidth;\n    const outer = box([openL - trimWidth, faceY - trimThick, bottom], [openR + trimWidth, faceY, openTop + trimWidth]);\n    const inner = box([openL, faceY - trimThick - 1, legsToFloor ? -1 : openBottom], [openR, faceY + 1, openTop]);\n    return new Assembly({ geometry: outer.cut(inner), color: \"#ffffff\", tags: [\"trim\"] });\n}\n"
