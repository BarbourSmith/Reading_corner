              ],
              "interpreterVersion": 1,
              "code": "/** Right Window glass pane, centred in the frame depth. mm, scan coordinates. */\nfunction run(\n  winL: number = 1265,\n  winR: number = 2141,\n  winSill: number = 510,\n  winHead: number = 2150,\n  outerY: number = -455,\n  frameDepth: number = 60,\n  frameWidth: number = 45,\n  glassThick: number = 6,\n): Assembly {\n  const midY = outerY - frameDepth / 2;\n  const pane = replicad.makeBox(\n    [winL + frameWidth, midY - glassThick / 2, winSill + frameWidth],\n    [winR - frameWidth, midY + glassThick / 2, winHead - frameWidth],\n  );\n  return new Assembly({ geometry: pane, color: \"#cfe6ee\" });\n}\n",
              "compiledCode": "\"use strict\";\n/** Right Window glass pane, centred in the frame depth. mm, scan coordinates. */\nfunction run(winL = 1265, winR = 2141, winSill = 510, winHead = 2150, outerY = -455, frameDepth = 60, frameWidth = 45, glassThick = 6) {\n    const midY = outerY - frameDepth / 2;\n    const pane = replicad.makeBox([winL + frameWidth, midY - glassThick / 2, winSill + frameWidth], [winR - frameWidth, midY + glassThick / 2, winHead - frameWidth]);\n    return new Assembly({ geometry: pane, color: \"#cfe6ee\" });\n}\n"
            },
