            }
          ],
          "interpreterVersion": 1,
          "code": "/** Room-side wall the alcove opens from. Drywall face at faceY, with the alcove opening and the two tall window openings cut through. mm, scan coordinates. */\nfunction run(\n  xLeft: number = -2850,\n  xRight: number = 2285,\n  faceY: number = -620,\n  wallThick: number = 165,\n  ceilingZ: number = 2575,\n  alcoveLeftX: number = -1143,\n  alcoveRightX: number = 1042,\n  leftWinL: number = -1810,\n  leftWinR: number = -1230,\n  leftSill: number = 510,\n  leftHead: number = 2165,\n  rightWinL: number = 1265,\n  rightWinR: number = 2141,\n  rightSill: number = 510,\n  rightHead: number = 2150,\n): Assembly {\n  const box = (a: number[], b: number[]) => replicad.makeBox(a, b);\n  // Cutters run 1 mm past both faces so the openings go cleanly through\n  const y0 = faceY - 1;\n  const y1 = faceY + wallThick + 1;\n  let wall = box([xLeft, faceY, 0], [xRight, faceY + wallThick, ceilingZ]);\n  wall = wall.cut(box([alcoveLeftX, y0, -1], [alcoveRightX, y1, ceilingZ + 1]));\n  wall = wall.cut(box([leftWinL, y0, leftSill], [leftWinR, y1, leftHead]));\n  wall = wall.cut(box([rightWinL, y0, rightSill], [rightWinR, y1, rightHead]));\n  return new Assembly({ geometry: wall, color: \"#efede8\", tags: [\"wall\"] });\n}\n",
          "compiledCode": "\"use strict\";\n/** Room-side wall the alcove opens from. Drywall face at faceY, with the alcove opening and the two tall window openings cut through. mm, scan coordinates. */\nfunction run(xLeft = -2850, xRight = 2285, faceY = -620, wallThick = 165, ceilingZ = 2575, alcoveLeftX = -1143, alcoveRightX = 1042, leftWinL = -1810, leftWinR = -1230, leftSill = 510, leftHead = 2165, rightWinL = 1265, rightWinR = 2141, rightSill = 510, rightHead = 2150) {\n    const box = (a, b) => replicad.makeBox(a, b);\n    // Cutters run 1 mm past both faces so the openings go cleanly through\n    const y0 = faceY - 1;\n    const y1 = faceY + wallThick + 1;\n    let wall = box([xLeft, faceY, 0], [xRight, faceY + wallThick, ceilingZ]);\n    wall = wall.cut(box([alcoveLeftX, y0, -1], [alcoveRightX, y1, ceilingZ + 1]));\n    wall = wall.cut(box([leftWinL, y0, leftSill], [leftWinR, y1, leftHead]));\n    wall = wall.cut(box([rightWinL, y0, rightSill], [rightWinR, y1, rightHead]));\n    return new Assembly({ geometry: wall, color: \"#efede8\", tags: [\"wall\"] });\n}\n"
        }
