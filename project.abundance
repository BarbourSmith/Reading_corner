          ],
          "interpreterVersion": 1,
          "code": "/** Alcove Window glass pane, centred in the frame depth. mm, scan coordinates. */\nfunction run(\n  winL: number = -980,\n  winR: number = 880,\n  winSill: number = 450,\n  winHead: number = 1990,\n  outerY: number = 320,\n  frameDepth: number = 60,\n  frameWidth: number = 45,\n  glassThick: number = 6,\n): Assembly {\n  const midY = outerY - frameDepth / 2;\n  const pane = replicad.makeBox(\n    [winL + frameWidth, midY - glassThick / 2, winSill + frameWidth],\n    [winR - frameWidth, midY + glassThick / 2, winHead - frameWidth],\n  );\n  return new Assembly({ geometry: pane, color: \"#cfe6ee\", tags: [\"window\", \"glass\"] });\n}\n",
          "compiledCode": "\"use strict\";\n/** Alcove Window glass pane, centred in the frame depth. mm, scan coordinates. */\nfunction run(winL = -980, winR = 880, winSill = 450, winHead = 1990, outerY = 320, frameDepth = 60, frameWidth = 45, glassThick = 6) {\n    const midY = outerY - frameDepth / 2;\n    const pane = replicad.makeBox([winL + frameWidth, midY - glassThick / 2, winSill + frameWidth], [winR - frameWidth, midY + glassThick / 2, winHead - frameWidth]);\n    return new Assembly({ geometry: pane, color: \"#cfe6ee\", tags: [\"window\", \"glass\"] });\n}\n"
        },
