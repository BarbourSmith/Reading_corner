              "code": "/** Left Window black vertical grille bars, evenly spaced on the room side of the glass. mm, scan coordinates. */\nfunction run(\n  winL: number = -1810,\n  winR: number = -1230,\n  winSill: number = 510,\n  winHead: number = 2165,\n  outerY: number = -455,\n  frameDepth: number = 60,\n  frameWidth: number = 45,\n  glassThick: number = 6,\n  barCount: number = 1,\n  barWidth: number = 30,\n  barDepth: number = 10,\n): Assembly {\n  const midY = outerY - frameDepth / 2;\n  const yGlass = midY - glassThick / 2; // room-side face of the glass\n  const x0 = winL + frameWidth;\n  const span = winR - frameWidth - x0;\n  let bars = null;\n  for (let i = 1; i <= barCount; i++) {\n    const cx = x0 + (span * i) / (barCount + 1);\n    const bar = replicad.makeBox(\n      [cx - barWidth / 2, yGlass - barDepth, winSill + frameWidth],\n      [cx + barWidth / 2, yGlass, winHead - frameWidth],\n    );\n    bars = bars ? bars.fuse(bar) : bar;\n  }\n  return new Assembly({ geometry: bars, color: \"#262626\" });\n}\n",
