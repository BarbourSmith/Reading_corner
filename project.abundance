              ],
              "interpreterVersion": 1,
              "code": "/** Alcove side wall (left one; the parent moves a copy to the right side). Inner face at innerX. mm, scan coordinates. */\nfunction run(\n  innerX: number = -1143,\n  wallThick: number = 165,\n  frontY: number = -455,\n  backY: number = 155,\n  ceilingZ: number = 2575,\n): Assembly {\n  const wall = replicad.makeBox([innerX - wallThick, frontY, 0], [innerX, backY, ceilingZ]);\n  return new Assembly({ geometry: wall, color: \"#efede8\" });\n}\n",
              "compiledCode": "\"use strict\";\n/** Alcove side wall (left one; the parent moves a copy to the right side). Inner face at innerX. mm, scan coordinates. */\nfunction run(innerX = -1143, wallThick = 165, frontY = -455, backY = 155, ceilingZ = 2575) {\n    const wall = replicad.makeBox([innerX - wallThick, frontY, 0], [innerX, backY, ceilingZ]);\n    return new Assembly({ geometry: wall, color: \"#efede8\" });\n}\n"
            }
          ],
